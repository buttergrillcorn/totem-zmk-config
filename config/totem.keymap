//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Undo {
            bindings = <&kp LC(Z)>;
            key-positions = <21 22>;
            timeout-ms = <50>;
            layers = <0>;
        };

        Cut {
            bindings = <&kp LC(X)>;
            key-positions = <23 22>;
            timeout-ms = <50>;
            layers = <0>;
        };

        Copy {
            bindings = <&kp LC(C)>;
            key-positions = <24 23>;
            timeout-ms = <50>;
            layers = <0>;
        };

        Paste {
            bindings = <&kp LC(V)>;
            key-positions = <24 22 23>;
            timeout-ms = <50>;
            layers = <0>;
        };

        left_parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 2>;
            timeout-ms = <30>;
            layers = <0>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <5 7>;
            timeout-ms = <30>;
            layers = <0>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <14 12>;
            timeout-ms = <30>;
            layers = <0>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <15 17>;
            timeout-ms = <30>;
            layers = <0>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <25 23>;
            timeout-ms = <30>;
            layers = <0>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <26 28>;
            timeout-ms = <30>;
            layers = <0>;
        };

        B1 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <31 0>;
            layers = <0>;
        };

        B2 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <31 1>;
            layers = <0>;
        };

        B3 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <31 2>;
            layers = <0>;
        };

        B4 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <31 3>;
            layers = <0>;
        };

        B5 {
            bindings = <&bt BT_SEL 4>;
            key-positions = <31 4>;
            layers = <0>;
        };

        B1D {
            bindings = <&bt BT_DISC 0>;
            key-positions = <31 10>;
            layers = <0>;
        };

        B2D {
            bindings = <&bt BT_DISC 1>;
            key-positions = <31 11>;
            layers = <0>;
        };

        B3D {
            bindings = <&bt BT_DISC 2>;
            key-positions = <31 12>;
            layers = <0>;
        };

        B4D {
            bindings = <&bt BT_DISC 3>;
            key-positions = <31 13>;
            layers = <0>;
        };

        B5D {
            bindings = <&bt BT_DISC 4>;
            key-positions = <31 14>;
            layers = <0>;
        };

        BCA {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <31 20>;
            layers = <0>;
        };

        BC {
            bindings = <&bt BT_CLR>;
            key-positions = <31 21>;
            layers = <0>;
        };

        EP-ON {
            bindings = <&ext_power EP_ON>;
            key-positions = <25 31>;
            layers = <0>;
        };

        BT {
            bindings = <&out OUT_BLE>;
            key-positions = <23 31>;
            layers = <0>;
        };

        USB {
            bindings = <&out OUT_USB>;
            key-positions = <31 24>;
            layers = <0>;
        };

        Reset {
            bindings = <&sys_reset>;
            key-positions = <0 21 9 30>;
            layers = <0>;
        };

        Redo {
            bindings = <&kp K_REDO>;
            key-positions = <10 11>;
            timeout-ms = <50>;
            layers = <0>;
        };

        MouseL {
            bindings = <&to 6>;
            key-positions = <12 11 13>;
            timeout-ms = <50>;
            layers = <0>;
        };

        MouseR {
            bindings = <&to 6>;
            key-positions = <17 18 16>;
            timeout-ms = <50>;
            layers = <0>;
        };

        MouseL_E {
            bindings = <&to 0>;
            key-positions = <11 12 13>;
            timeout-ms = <50>;
            layers = <6>;
        };

        MouseR_E {
            bindings = <&to 0>;
            key-positions = <18 17 16>;
            timeout-ms = <50>;
            layers = <6>;
        };

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
            timeout-ms = <50>;
            layers = <0 2>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            timeout-ms = <50>;
            layers = <0 2>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <17 18>;
            timeout-ms = <50>;
            layers = <0 2>;
        };

        Deleted {
            bindings = <&kp DELETE>;
            key-positions = <7 8>;
            timeout-ms = <50>;
            layers = <0 2>;
        };

        Off {
            bindings = <&soft_off>;
            key-positions = <13 31>;
            timeout-ms = <50>;
            layers = <0>;
            require-prior-idle-ms = <200>;
        };
    };

    behaviors {
        Mod_Tap_L: Mod_Tap_L {
            compatible = "zmk,behavior-hold-tap";
            label = "MTL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <35 36 37 26 27 15 16 5 6 7 17 28 29 18 8 9 19 30 31 34 33 32>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <175>;
            hold-trigger-on-release;
        };

        Mod_Tap_R: Mod_Tap_R {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34 35 36 37>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <175>;
            hold-trigger-on-release;
        };

        Thumb_HT: Thumb_HT {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_HT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        Backspace_HT: Backspace_HT {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACE_HT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
        };

        CapsWordShift: CapsWordShift {
            compatible = "zmk,behavior-hold-tap";
            label = "CAPSWORDSHIFT";
            bindings = <&kp>, <&caps_word>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <0>;
            flavor = "hold-preferred";
        };

        num_word: num_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <BSPC DEL DOT COMMA MINUS EQUAL KP_PLUS KP_MINUS SLASH BSLH SEMI GRAVE>;
            ignore-numbers;
        };

        num_lt: num_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&num_word>;
        };

        nav_word: nav_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <LEFT DOWN UP RIGHT HOME END PG_UP PG_DN BSPC DEL>;
            ignore-modifiers;
        };

        nav_lt: nav_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "NAV_LT";
            bindings = <&mo>, <&nav_word>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "BASE";
            bindings = <
          &kp Q           &kp W  &kp E                   &kp R        &kp T        &kp Y          &kp U        &kp I                &kp O                    &kp P
          &kp A           &kp S  &kp D                   &kp F        &kp G        &kp H          &kp J        &kp K                &kp L                    &mt COLON SEMI
&kp LGUI  &mt LEFT_ALT Z  &kp X  &kp C                   &kp V        &kp B        &kp N          &kp M        &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &mt QUESTION SLASH  &mt DOUBLE_QUOTES SINGLE_QUOTE
                                 &CapsWordShift LSHFT 0  &nav_lt 1 0  &kp SPACE    &kp BACKSPACE  &num_lt 2 2  &kp LCTRL
            >;
        };

        Navigation {
            display-name = "NAV";
            bindings = <
          &kp ESCAPE    &trans  &trans     &trans     &kp C_BRIGHTNESS_INC    &kp HOME        &kp PAGE_DOWN  &kp PAGE_UP   &kp END     &kp K_MUTE
          &kp TAB       &trans  &trans     &trans     &kp K_SLEEP             &kp LEFT        &kp DOWN       &kp UP_ARROW  &kp RIGHT   &kp PRINTSCREEN
&sk LGUI  &sk LEFT_ALT  &trans  &trans     &trans     &kp C_BRIGHTNESS_DEC    &kp C_PREVIOUS  &kp C_VOL_DN   &kp C_VOL_UP  &kp C_NEXT  &kp C_PLAY_PAUSE  &kp RIGHT_ALT
                                &sk LSHFT  &kp LCTRL  &kp SPACE               &trans          &trans         &trans
            >;
        };

        Number {
            display-name = "NUM";
            bindings = <
          &kp ESCAPE    &trans  &trans     &trans     &trans       &mt EQUAL KP_PLUS               &mt AMPERSAND NUMBER_7    &mt ASTRK NUMBER_8  &mt LEFT_PARENTHESIS NUMBER_9  &mt TILDE GRAVE
          &kp TAB       &trans  &trans     &trans     &trans       &mt UNDERSCORE KP_MINUS         &mt DOLLAR NUMBER_4       &mt PERCENT N5      &mt CARET NUMBER_6             &kp COLON
&sk LGUI  &sk LEFT_ALT  &trans  &trans     &trans     &trans       &mt RIGHT_PARENTHESIS NUMBER_0  &mt EXCLAMATION NUMBER_1  &mt AT NUMBER_2     &mt HASH NUMBER_3              &kp PERIOD       &mt PIPE BACKSLASH
                                &sk LSHFT  &kp LCTRL  &kp SPACE    &trans                          &trans                    &trans
            >;
        };

        Function {
            display-name = "FUNC";
            bindings = <
          &kp ESCAPE    &trans  &trans     &trans     &to 4        &trans         &kp F7  &kp F8  &kp F9  &kp F10
          &kp TAB       &trans  &trans     &trans     &trans       &kp LC(LS(S))  &kp F4  &kp F5  &kp F6  &kp F11
&sk LGUI  &sk LEFT_ALT  &trans  &trans     &trans     &trans       &trans         &kp F1  &kp F2  &kp F3  &kp F12  &kp PRINTSCREEN
                                &sk LSHFT  &kp LCTRL  &kp SPACE    &trans         &trans  &trans
            >;
        };

        Game {
            display-name = "GAME";
            bindings = <
            &kp LSHFT         &kp Q  &kp X  &kp E    &kp R        &trans  &trans  &trans  &trans  &trans
            &kp LEFT_CONTROL  &kp A  &kp W  &kp D    &kp F        &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &kp LEFT_ALT      &kp Z  &kp S  &kp C    &kp V        &trans  &trans  &trans  &trans  &trans  &trans
                                     &sl 5  &kp TAB  &kp SPACE    &trans  &trans  &trans
            >;
        };

        GamePlus {
            display-name = "GAME+";
            bindings = <
       &kp NUMBER_1  &kp N2  &kp N3  &kp N4  &kp N5    &trans  &trans  &trans  &trans  &trans
       &kp I         &kp Y   &kp T   &kp H   &kp G     &trans  &trans  &trans  &trans  &trans
&to 0  &trans        &kp L   &kp B   &kp N   &kp M     &trans  &trans  &trans  &trans  &trans  &trans
                             &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        Mouse {
            bindings = <
              &sk LEFT_CONTROL  &msc SCRL_LEFT  &mkp MB3        &msc SCRL_RIGHT  &msc SCRL_UP      &msc SCRL_UP    &msc SCRL_LEFT  &mkp MB3        &msc SCRL_RIGHT  &sk RIGHT_CONTROL
              &sk LEFT_SHIFT    &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &msc SCRL_DOWN    &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &kp RIGHT_SHIFT
&kp LEFT_ALT  &mkp MB5          &mkp MB2        &mmv MOVE_DOWN  &mkp MB1         &mkp MB4          &mkp MB4        &mkp MB1        &mmv MOVE_DOWN  &mkp MB2         &mkp MB5           &kp RIGHT_ALT
                                                &mkp MB2        &mkp MB3         &mkp MB1          &mkp MB1        &mkp MB3        &mkp MB2
            >;

            label = "Mouse";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Function {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
